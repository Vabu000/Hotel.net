{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "swagger-reservations-route": {
        "ClusterId": "reservation-cluster",
        "Order": 0,
        "Match": { "Path": "/swagger/reservations.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-catalog-route": {
        "ClusterId": "catalog-cluster",
        "Order": 0,
        "Match": { "Path": "/swagger/catalog.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-reviews-route": {
        "ClusterId": "reviews-cluster",
        "Order": 0,
        "Match": { "Path": "/swagger/reviews.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-payments-route": {
        "ClusterId": "payments-cluster",
        "Order": 0,
        "Match": { "Path": "/swagger/payments.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-aggregator-route": {
        "ClusterId": "aggregator-cluster",
        "Order": 0,
        "Match": { "Path": "/swagger/aggregator.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "reservation-clients-route": {
        "ClusterId": "reservation-cluster",
        "Order": 2,
        "Match": { "Path": "/api/Client/{**catch-all}" }
      },
      "reservation-rooms-route": {
        "ClusterId": "reservation-cluster",
        "Order": 2,
        "Match": { "Path": "/api/Room/{**catch-all}" }
      },
      "reservation-payments-route": {
        "ClusterId": "reservation-cluster",
        "Order": 2,
        "Match": { "Path": "/api/Payment/{**catch-all}" }
      },
      "catalog-discounts-route": {
        "ClusterId": "catalog-cluster",
        "Order": 2,
        "Match": { "Path": "/api/DiscountCategory/{**catch-all}" }
      },
      "reviews-requests-route": {
        "ClusterId": "reviews-cluster",
        "Order": 2,
        "Match": { "Path": "/api/Requests/{**catch-all}" }
      },
      "reviews-route": {
        "ClusterId": "reviews-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "reservations-route": {
        "ClusterId": "reservations-cluster",
        "Match": {
          "Path": "/api/Reservation/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/Service/{**catch-all}"
        }
      },
      "room-categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/RoomCategory/{**catch-all}"
        }
      },
      "aggregator-route": {
        "ClusterId": "aggregator-cluster",
        "Match": {
          "Path": "/api/RoomAggregator/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auth-service"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://payments-service"
          }
        }
      },
      "reviews-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://reviews-service"
          }
        }
      },
      "reservations-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://reservation-service"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog-service"
          }
        }
      },
      "aggregator-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://aggregator"
          }
        }
      }
    }
  }
}
