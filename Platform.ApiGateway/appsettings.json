{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "reviews-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "reservations-route": {
        "ClusterId": "reservations-cluster",
        "Match": {
          "Path": "/api/Reservation/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/Service/{**catch-all}"
        }
      },
      "room-categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/RoomCategory/{**catch-all}"
        }
      },
      "aggregator-route": {
        "ClusterId": "aggregator-cluster",
        "Match": {
          "Path": "/api/RoomAggregator/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auth-service"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://payments-service"
          }
        }
      },
      "reviews-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://reviews-service"
          }
        }
      },
      "reservations-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://reservation-service"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog-service"
          }
        }
      },
      "aggregator-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://aggregator"
          }
        }
      }
    }
  }
}
